# Rubix Testnet Environment Variables
# Copy this file to .env and fill in your values
# Then run: source .env

# Password Configuration
# Set these to avoid being prompted for passwords
RUBIX_PRIV_PWD=mypassword
RUBIX_QUORUM_PWD=mypassword

# Configuration Overrides
# Override node counts without editing config.yaml
#RUBIX_QUORUM_COUNT=5
#RUBIX_NON_QUORUM_COUNT=2

# Workspace Path Override
# Specify a custom workspace location
#RUBIX_WORKSPACE=/opt/rubix

# Logging Level Override
# Options: DEBUG, INFO, WARNING, ERROR
#RUBIX_LOG_LEVEL=INFO
